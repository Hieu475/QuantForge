{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ubuntu 24.04, apt LLVM/MLIR 18",
      "description": "Needs: llvm-18-dev libmlir-18-dev mlir-18-tools ninja-build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MLIR_DIR": "/usr/lib/llvm-18/lib/cmake/mlir",
        "LLVM_DIR": "/usr/lib/llvm-18/lib/cmake/llvm"
      }
    },
    {
      "name": "ci",
      "inherits": "default",
      "displayName": "CI (no GPU tests registered)",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QUANTFORGE_ENABLE_E2E_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "ci", "configurePreset": "ci" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "lit",
      "configurePreset": "ci",
      "filter": { "include": { "label": "lit" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gpu",
      "configurePreset": "default",
      "filter": { "include": { "label": "gpu" } },
      "output": { "outputOnFailure": true }
    }
  ]
}
